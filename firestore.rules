rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly([
          'type',
          'title',
          'description',
          'location',
          'contact',
          'createdAt'
        ]) &&
        request.resource.data.type in ['offer', 'request'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 70 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 10 &&
        request.resource.data.description.size() <= 280 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() >= 2 &&
        request.resource.data.location.size() <= 60 &&
        request.resource.data.contact is string &&
        request.resource.data.contact.size() >= 3 &&
        request.resource.data.contact.size() <= 90 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
